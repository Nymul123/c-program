rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidStudent(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.regNo is string && data.regNo.size() > 0 && data.regNo.size() <= 64 &&
             data.photoUrl is string && data.photoUrl.size() > 0 && data.photoUrl.size() <= 2000000 &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 64;
    }

    match /students/{studentId} {
      // Public verification: Anyone can read student records to verify academic credentials
      allow read: if true;
      // Validated write operations for administrative updates
      allow create, update: if isValidStudent(request.resource.data);
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
